# Copy this file to /opt/data/.env inside the customer Hermes container or to the Hostinger project env file.
# NEVER commit real secrets.

# Hostinger dashboard / WebUI values may already exist from Hostinger one-click deployment.
# Keep customer-specific secrets outside Git.
ADMIN_USERNAME=
ADMIN_PASSWORD=
TRAEFIK_HOST=

# LINE Messaging API credentials from the client's LINE Developers channel.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Public base URL WITHOUT /line/webhook suffix.
# Example: https://customer-a.srvxxxx.hstgr.cloud
LINE_PUBLIC_URL=

# LINE adapter listen settings.
LINE_HOST=0.0.0.0
LINE_PORT=8646

# For a client-owned public OA initial deployment, allow-all is usually OK.
# For private/internal bots, set false and use LINE_ALLOWED_USERS after bootstrap.
LINE_ALLOW_ALL_USERS=true
LINE_ALLOWED_USERS=
LINE_HOME_CHANNEL=

# Optional model/provider keys. Fill according to the client's chosen provider.
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional local STT wrapper if voice transcription is configured.
HERMES_LOCAL_STT_COMMAND=
HERMES_LOCAL_STT_LANGUAGE=zh
